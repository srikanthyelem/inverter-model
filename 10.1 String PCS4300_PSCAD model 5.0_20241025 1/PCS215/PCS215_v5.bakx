    <Definition classid="UserCmpDefn" name="oc_spov" id="1715961357" group="" url="" version="" build="" crc="20051645" view="false" date="0">
      <paramlist name="">
        <param name="Description" value="" />
      </paramlist>
      <script>
        <segment name="Dsdyn" id="1153678108" classid="CoreSegment"><![CDATA[#STORAGE INTEGER:6 REAL:795 RTCF:9 STXFRI:7 STXFRF:7 
!
#BEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL oc_spovDyn_Begin()
#ENDBEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL oc_spovDyn($spov_trip, $spov_gblock, $oc_block, $iabc, $vabc, $vnom, $Ipeak, $SPOV_Vblock, $SPOV_Vtrip, $SPOV_Ttrip)
!]]></segment>
        <segment name="Dsout" id="376285602" classid="CoreSegment"><![CDATA[!
#BEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL oc_spovOut_Begin()
#ENDBEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL oc_spovOut()
!]]></segment>
      </script>
      <form name="" w="698" h="529" splitter="60" category-width="180" commentlines="4" help-width="490">
        <category name="Configuration" visible="true">
          <cond />
          <parameter desc="Name" name="Name" group="" type="Text" helpmode="Append" allowemptystr="true" min="0" max="0">
            <value />
            <cond />
            <help />
            <regex />
            <error_msg />
            <vis />
          </parameter>
          <parameter desc="AC Nominal Voltage [kV]" name="vnom" group="" unit="" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.69]]></value>
            <cond />
            <help><![CDATA[AC nominal L-L voltage in kV]]></help>
            <vis />
          </parameter>
        </category>
        <category name="over current pulse block function" visible="true">
          <cond />
          <parameter desc="Peak current for over current blocking [kA]" name="Ipeak" group="General" unit="kA" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.293]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
        </category>
        <category name="SPOV block and tripping" visible="true">
          <cond />
          <parameter desc="Peak value for gateblock [pu]" name="SPOV_Vblock" group="" unit="" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1.35]]></value>
            <cond />
            <help><![CDATA[When the peak value of instantaneous AC voltage is greater than [SPOV_Vblock] times the peak value of the nominal AC voltage, the inverter will gateblock and stop feeding in power to the grid.]]></help>
            <vis />
          </parameter>
          <parameter desc="RMS voltage for trip, spov_vtrip [pu]" name="SPOV_Vtrip" group="General" unit="" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[1.267]]></value>
            <cond />
            <help><![CDATA[When the rms value of AC voltage is greater than [spov_Vtrip] for [spov_Ttrip]s, trip inverter]]></help>
            <vis />
          </parameter>
          <parameter desc="RMS voltage trip time delay, SPOV_Ttrip [s]" name="SPOV_Ttrip" group="General" unit="" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.5]]></value>
            <cond />
            <help><![CDATA[time delay in seconds]]></help>
            <vis />
          </parameter>
        </category>
      </form>
