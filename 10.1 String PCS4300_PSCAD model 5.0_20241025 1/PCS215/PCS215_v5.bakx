        <line x1="72" y1="-36" x2="55" y2="-36" stroke="Black" stroke-width="ByNode" stroke-dasharray="None" port="Out" />
        <text x="71" y="56" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[FltTime]]></text>
        <line x1="55" y1="36" x2="71" y2="36" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <text x="-63" y="13" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[CONID]]></text>
        <text x="65" y="-22" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[BRK]]></text>
        <cond><![CDATA[NSelect>=2]]></cond>
        <text x="-36" y="-48" stroke="Black" font-size="Small" text-anchor="Start"><![CDATA[$Select2 : $ft2]]></text>
        <cond><![CDATA[NSelect>=3]]></cond>
        <text x="-36" y="-36" stroke="Black" font-size="Small" text-anchor="Start"><![CDATA[$Select3 : $ft3]]></text>
        <cond><![CDATA[NSelect>=4]]></cond>
        <text x="-36" y="-23" stroke="Black" font-size="Small" text-anchor="Start"><![CDATA[$Select4 : $ft4]]></text>
        <cond><![CDATA[NSelect>=5]]></cond>
