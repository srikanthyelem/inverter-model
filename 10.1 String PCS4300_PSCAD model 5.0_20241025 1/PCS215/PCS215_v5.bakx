        <port model="Transfer" name="OutX" x="72" y="-36" dim="1" mode="Output" type="Integer" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="FaultTime" x="72" y="36" dim="1" mode="Output" type="Real" internal="false"><![CDATA[true]]></port>
        <cond><![CDATA[true]]></cond>
        <rect x="-37" y="-73" height="134" width="93" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" fill-style="Hollow" fill-fg="Black" fill-bg="White" />
        <line x1="-54" y1="0" x2="-37" y2="0" stroke="Black" stroke-width="ByNode" stroke-dasharray="None" port="In" />
        <line x1="-37" y1="0" x2="-42" y2="-5" stroke="Black" stroke-width="ByNode" stroke-dasharray="None" port="In" />
