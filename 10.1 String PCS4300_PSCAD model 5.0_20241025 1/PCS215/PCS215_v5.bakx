    <Definition classid="UserCmpDefn" name="Electranix_xfmr_3w_1" group="" url="" version="" build="" instances="1" view="false" date="0" id="368077878">
      <paramlist>
        <param name="Description" value="PSSE Compatible 3 winding transformer" />
        <param name="Name" value="Electranix_xfmr_3w_1" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration">
          <parameter type="Text" name="Name" desc="Transformer Name" group="" helpmode="Append">
            <value><![CDATA[T1]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Tmva3" desc="Transformer MVA (3 phase)" group="" helpmode="Append" content_type="Literal" intent="Input" min="1e-006" max="" dim="1" unit="MVA">
            <value><![CDATA[100]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="f" desc="Base Frequency (Hz)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="Hz">
            <value><![CDATA[60]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Enable" desc="Is this Device Enabled?" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[0 = No (Disabled)]]></choice>
            <choice><![CDATA[1 = Yes (Enabled)]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="V5Format" desc="Use new PSCAD V5 Transformer Format?" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Winding Data">
          <parameter type="Real" name="V1LL" desc="Winding #1 Volts (kV,L-L,rms)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
