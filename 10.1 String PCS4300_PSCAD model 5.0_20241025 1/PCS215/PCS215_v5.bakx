            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="V3LL" desc="Tertiary Winding #3 Volts (kV,L-L,rms)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
            <value><![CDATA[13.8]]></value>
            <help><![CDATA[]]></help>
          </parameter>
