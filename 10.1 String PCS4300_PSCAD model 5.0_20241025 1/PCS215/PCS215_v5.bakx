            <value><![CDATA[0.01]]></value>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Xl12" desc="X12 - Leakage Reactance (pu)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="1" dim="1" unit="p.u.">
