        <cond><![CDATA[(View==1)]]></cond>
        <ellipse cx="-22" cy="0" rx="18" ry="18" stroke="Black" stroke-width="0.6" stroke-dasharray="None" port="" fill-style="Hollow" fill-fg="Black" fill-bg="White" />
