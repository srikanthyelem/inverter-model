        <line x1="22" y1="-5" x2="4" y2="-16" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <line x1="22" y1="-5" x2="22" y2="16" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <cond><![CDATA[(YD2!=0)&&(View==0)]]></cond>
        <line x1="40" y1="-16" x2="58" y2="16" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <line x1="58" y1="16" x2="22" y2="16" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <line x1="22" y1="16" x2="40" y2="-16" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
        <cond><![CDATA[(YD1!=0)&&(View==0)]]></cond>
        <line x1="-4" y1="16" x2="-40" y2="16" stroke="Black" stroke-width="0.2" stroke-dasharray="None" port="" />
