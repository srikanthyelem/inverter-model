      <script>
        <segment name="Dsdyn" id="769898131" classid="CoreSegment"><![CDATA[#STORAGE INTEGER:4 REAL:17 RTCF:2 STXFRF:13 
!
#BEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL special_funcsDyn_Begin()
#ENDBEGIN
      CALL COMPONENT_ID(ICALL_NO,$#Component)
      CALL special_funcsDyn($Qref, $Qmeas, $Qref1, $vabc, $fnom, $Enable_Active_Islanding, $k_slope, $Enable_SSDC, $Kssdc, $T1ssdc, $T2ssdc)
!]]></segment>
