    <Definition classid="UserCmpDefn" name="xfmr_2w_scaled" group="" url="" version="" build="" crc="17728424" instances="1" view="false" date="0" id="2101137099">
      <paramlist>
        <param name="Description" value="3 Phase 2 Winding Transformer - With Scaling!" />
      </paramlist>
      <form name="" w="320" h="400" splitter="60">
        <category name="Configuration" visible="true">
          <cond />
          <parameter type="Text" name="Name" desc="Transformer Name" group="" helpmode="Append" allowemptystr="True">
            <value><![CDATA[T32]]></value>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="Tmva" desc="3 Phase Transformer MVA" group="" helpmode="Append" content_type="Literal" intent="Input" min="1e-006" max="" dim="1" unit="MVA">
            <value><![CDATA[100.0]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="f" desc="Base operation frequency" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="Hz">
            <value><![CDATA[60.0]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Choice" name="YD1" desc="Winding #1 Type" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = Y]]></choice>
            <choice><![CDATA[1 = Delta]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Choice" name="YD2" desc="Winding #2 Type" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[0 = Y]]></choice>
            <choice><![CDATA[1 = Delta]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Choice" name="Lead" desc="Delta Lags or Leads Y" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[1 = Lags]]></choice>
            <choice><![CDATA[2 = Leads]]></choice>
            <regex />
            <error_msg />
            <cond><![CDATA[YD1 != YD2]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Real" name="Xl" desc="Positive sequence leakage reactance" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="1" dim="1" unit="pu">
            <value><![CDATA[0.1]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Choice" name="Ideal" desc="Ideal Transformer Model" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="NLL" desc="No load losses" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="1" dim="1" unit="pu">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="CuL" desc="Copper losses" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="1" dim="1" unit="pu">
            <value><![CDATA[0.0]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Choice" name="Tap" desc="Tap changer on winding" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = None]]></choice>
            <choice><![CDATA[1 = #1]]></choice>
            <choice><![CDATA[2 = #2]]></choice>
            <regex />
            <error_msg />
            <cond><![CDATA[(true)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="View" desc="Graphics Display" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = 3 phase view]]></choice>
            <choice><![CDATA[1 = Single line (circles)]]></choice>
            <choice><![CDATA[2 = Single line (windings)]]></choice>
            <regex />
            <error_msg />
            <cond><![CDATA[(true)]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter type="Choice" name="Dtls" desc="Display Details?" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
            <regex />
            <error_msg />
            <cond><![CDATA[View!=0]]></cond>
            <help><![CDATA[]]></help>
          </parameter>
        </category>
        <category name="Winding Voltages" visible="true">
          <cond />
          <parameter type="Real" name="V1" desc="Winding 1 Line to Line voltage (RMS)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
            <value><![CDATA[230.0]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="V2" desc="Winding 2 Line to Line voltage (RMS)" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="" dim="1" unit="kV">
            <value><![CDATA[230.0]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
        </category>
        <category name="Saturation" visible="true">
          <cond />
          <parameter type="Choice" name="Enab" desc="Saturation Enabled" group="" helpmode="Append">
            <value><![CDATA[0]]></value>
            <choice><![CDATA[0 = No]]></choice>
            <choice><![CDATA[1 = Yes]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Choice" name="Sat" desc="Saturation Placed on Winding" group="" helpmode="Append">
            <value><![CDATA[1]]></value>
            <choice><![CDATA[1 = #1]]></choice>
            <choice><![CDATA[2 = #2]]></choice>
            <regex />
            <error_msg />
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="Xair" desc="Air core reactance" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.001" max="10" dim="1" unit="pu">
            <value><![CDATA[0.2]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="Tdc" desc="In rush decay time constant" group="" helpmode="Append" content_type="Literal" intent="Input" min="-100" max="" dim="1" unit="s">
            <value><![CDATA[1.0]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="Xknee" desc="Knee voltage" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="" dim="1" unit="pu">
            <value><![CDATA[1.25]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="Txk" desc="Time to release flux clipping" group="" helpmode="Append" content_type="Literal" intent="Input" min="0" max="1e+006" dim="1" unit="s">
            <value><![CDATA[0.1]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
          <parameter type="Real" name="Im1" desc="Magnetizing current" group="" helpmode="Append" content_type="Literal" intent="Input" min="0.0001" max="1000" dim="1" unit="%">
            <value><![CDATA[0.4]]></value>
            <help><![CDATA[]]></help>
            <cond />
          </parameter>
        </category>
