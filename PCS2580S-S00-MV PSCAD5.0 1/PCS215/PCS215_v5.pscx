      <script>
        <segment name="Fortran" id="358880265" classid="CoreSegment"><![CDATA[#LOCAL INTEGER TEMP_INT_1(9)
#LOCAL INTEGER TEMP_INT_2
#LOCAL INTEGER TEMP_INT_3(9)
#LOCAL REAL TEMP_REL_1(9)
#LOCAL REAL TEMP_REL_2(9)


      TEMP_INT_1(1) = $Select1
      TEMP_INT_1(2) = $Select2
      TEMP_INT_1(3) = $Select3
      TEMP_INT_1(4) = $Select4
      TEMP_INT_1(5) = $Select5
      TEMP_INT_1(6) = $Select6
      TEMP_INT_1(7) = $Select7
      TEMP_INT_1(8) = $Select8
      TEMP_INT_1(9) = $Select9

      TEMP_REL_1(1) = $Bdelay1
      TEMP_REL_1(2) = $Bdelay2
      TEMP_REL_1(3) = $Bdelay3
      TEMP_REL_1(4) = $Bdelay4
      TEMP_REL_1(5) = $Bdelay5
      TEMP_REL_1(6) = $Bdelay6
      TEMP_REL_1(7) = $Bdelay7
      TEMP_REL_1(8) = $Bdelay8
      TEMP_REL_1(9) = $Bdelay9



      TEMP_INT_3(1) = $ft1
      TEMP_INT_3(2) = $ft2
      TEMP_INT_3(3) = $ft3
      TEMP_INT_3(4) = $ft4
      TEMP_INT_3(5) = $ft5
      TEMP_INT_3(6) = $ft6
      TEMP_INT_3(7) = $ft7
      TEMP_INT_3(8) = $ft8
      TEMP_INT_3(9) = $ft9

      TEMP_REL_2(1) = $Rec_delay1
      TEMP_REL_2(2) = $Rec_delay2
      TEMP_REL_2(3) = $Rec_delay3
      TEMP_REL_2(4) = $Rec_delay4
      TEMP_REL_2(5) = $Rec_delay5
      TEMP_REL_2(6) = $Rec_delay6
      TEMP_REL_2(7) = $Rec_delay7
      TEMP_REL_2(8) = $Rec_delay8
      TEMP_REL_2(9) = $Rec_delay9


      $FaultTime =999.0
      DO TEMP_INT_2 = 1,$NSelect
        IF( $CONID .EQ. TEMP_INT_1(TEMP_INT_2)) THEN
          IF((TEMP_INT_3(TEMP_INT_2).EQ.1).OR.(TEMP_INT_3(TEMP_INT_2).EQ.3) )THEN
             $FaultTime =$ftime
          ENDIF
          EXIT
        ENDIF
      END DO

      DO TEMP_INT_2 = 1,$NSelect
        IF( $CONID .EQ. TEMP_INT_1(TEMP_INT_2)) THEN
            IF( (TEMP_INT_3(TEMP_INT_2).EQ.2 ) ) THEN
              $OutX = 1
              EXIT
            ENDIF
            IF( (TEMP_INT_3(TEMP_INT_2).LE.1 ).AND. (TIME.GE.(TEMP_REL_1(TEMP_INT_2)+$ftime)) )THEN
              $OutX = 1
              EXIT
            ENDIF
            IF( (TEMP_INT_3(TEMP_INT_2).EQ.3 ).AND. (TIME.GE.(TEMP_REL_1(TEMP_INT_2)+$ftime)) )THEN
              $OutX = 1
              IF ( (TIME.GE.(TEMP_REL_2(TEMP_INT_2)+$ftime)).AND.(TIME.LT.(TEMP_REL_2(TEMP_INT_2)+$ftime+TEMP_REL_1(TEMP_INT_2)) )) THEN
                  $OutX = 0
              ENDIF
              EXIT
            ENDIF

        ENDIF
      END DO]]></segment>
        <segment name="Branch" id="1384985908" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="1919386707" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
      <svg viewBox="-200 -200 200 200">
